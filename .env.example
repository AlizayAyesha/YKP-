# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public site URL used in emails and poster links.
APP_URL="http://localhost:3000"

# Registration API
API_PORT="8788"

# Admin attendees view (#admin) — send this key in the form.
ADMIN_KEY="change-me"

# Email (optional until configured). Registration still saves if these are missing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Youth Ka Pakistan <info@youthkapakistan.com>"

# Google Sheet for Founder & CEO RSVPs only (Students are not sent).
# Create a Sheet, add an Apps Script web app from the comment in server/sheets.ts, then paste the web app URL here.
GOOGLE_SHEETS_WEBHOOK_URL=""
