# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public site URL used in emails and poster links.
APP_URL="http://localhost:3000"

# Registration API
API_PORT="8788"

# Admin attendees view (#admin) — send this key in the form.
ADMIN_KEY="change-me"

# Inbox that receives every form (contact, enroll, student, partner, RSVP).
CONTACT_INBOX="info@youthkapakistan.com"

# Preferred on Vercel: create a Resend API key and verify the from-domain.
RESEND_API_KEY=""
RESEND_FROM="Youth Ka Pakistan <info@youthkapakistan.com>"

# Email (optional if RESEND_API_KEY is set). Forms still notify via FormSubmit fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Youth Ka Pakistan <info@youthkapakistan.com>"

# One Google Sheet for every form. Apps Script creates these tabs:
# All Submissions, RSVPs, Students, Inquiries, Contact, Enrollments, Profiles, Founders.
# Setup: see the comment at the top of server/sheets.ts.
GOOGLE_SHEETS_WEBHOOK_URL=""
