{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/registrations.ts": {
      "maxDuration": 60,
      "includeFiles": "{public/posters/**,src/data/events.json,server/**}"
    },
    "api/[[...path]].ts": {
      "maxDuration": 60,
      "includeFiles": "{public/posters/**,src/data/events.json}"
    }
  }
}
